{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 4,

    "modules-left": ["sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["clock"],
    "modules-right": ["tray", "cpu", "memory", "network", "pulseaudio", "custom/power"],

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": false
    },
    "sway/mode": {
        "format": "󰩨 {}"
    },
    "sway/scratchpad": {
        "format": "󰖯 {count}",
        "show-empty": false,
        "tooltip": true,
        "tooltip-format": "{app}: {title}"
    },

    "clock": {
        "format": "{:%m/%d %a  %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#88c0d0'><b>{}</b></span>"
            }
        }
    },

    "cpu": {
        "format": "cpu {usage}%",
        "interval": 5,
        "states": { "warning": 70, "critical": 90 }
    },
    "memory": {
        "format": "mem {percentage}%",
        "states": { "warning": 75, "critical": 90 },
        "tooltip-format": "{used:0.1f} / {total:0.1f} GiB",
        "interval": 5
    },
    "network": {
        "format-wifi": "󰤨 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 離線",
        "tooltip-format": "{ifname}: {ipaddr}/{cidr}\n {bandwidthUpBytes}   {bandwidthDownBytes}",
        "on-click": "nm-connection-editor"
    },
    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 靜音",
        "format-icons": { "default": ["󰕿", "󰖀", "󰕾"] },
        "on-click": "pavucontrol",
        "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "scroll-step": 5
    },
    "tray": {
        "spacing": 8
    },
    "custom/power": {
        "format": "\udb81\udc25",
        "tooltip-format": "電源",
        "on-click": "~/.config/sway/scripts/power-menu.sh"
    }
}
